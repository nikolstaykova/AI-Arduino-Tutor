# Copy this file to .env (which git ignores) and fill in ONE of these.
# bench_server.py loads it at startup; values already in your environment win.

# Your own Claude subscription, via Claude Code: run `claude setup-token`
# in a terminal and paste the token it prints here.
# CLAUDE_CODE_OAUTH_TOKEN=

# Or a pay-as-you-go API key from console.anthropic.com (also needs `pip install anthropic`).
# ANTHROPIC_API_KEY=

# Optional: force a route (claude-code / api / none) or pick the model.
# CQ_AI_BACKEND=
# CQ_CLAUDE_MODEL=opus

# Optional: accounts (Sign in with Google) and shared lessons via Supabase —
# see cloud/SETUP.md. Leave empty to keep everything in local files.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
